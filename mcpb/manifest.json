{
  "$schema": "https://raw.githubusercontent.com/modelcontextprotocol/mcpb/main/schemas/mcpb-manifest-v0.4.schema.json",
  "manifest_version": "0.4",
  "name": "korean-special-education-curriculum",
  "display_name": "2022 개정 특수교육 교육과정",
  "version": "0.1.0",
  "description": "2022 개정 특수교육 교육과정의 현행 법정 원문 29개를 출처와 함께 검색합니다.",
  "long_description": "중·고등학교 특수교육 기본·공통·선택 중심 교육과정과 준용 일반교육과정 별책을 검색하고, 성취기준 코드·쪽수·공식 원문 링크를 반환하는 읽기 전용 MCP 서버입니다.",
  "author": {
    "name": "sonbyobyo",
    "url": "https://github.com/sonbyobyo"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sonbyobyo/korean-special-education-curriculum-mcp"
  },
  "homepage": "https://github.com/sonbyobyo/korean-special-education-curriculum-mcp",
  "documentation": "https://github.com/sonbyobyo/korean-special-education-curriculum-mcp#readme",
  "support": "https://github.com/sonbyobyo/korean-special-education-curriculum-mcp/issues",
  "server": {
    "type": "node",
    "entry_point": "server/server.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/server/server.js"]
    }
  },
  "tools": [
    {
      "name": "get_coverage_report",
      "description": "수록된 법정 교육과정과 선택형 보충자료 범위를 확인합니다."
    },
    {
      "name": "list_official_sources",
      "description": "공식 출처, 고시 번호, 원문 URL과 준비 상태를 확인합니다."
    },
    {
      "name": "search_curriculum",
      "description": "교육과정 원문을 교과·학교급·교육과정 유형별로 검색합니다."
    },
    {
      "name": "get_curriculum_chunk",
      "description": "검색 결과의 원문 청크와 정확한 출처 위치를 조회합니다."
    },
    {
      "name": "find_achievement_standard",
      "description": "성취기준 코드로 원문과 출처를 찾습니다."
    }
  ],
  "keywords": ["특수교육", "교육과정", "2022 개정 교육과정", "대한민국", "성취기준"],
  "license": "SEE LICENSE IN LICENSES.md",
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": ["darwin", "win32", "linux"],
    "runtimes": {
      "node": ">=20"
    }
  }
}
